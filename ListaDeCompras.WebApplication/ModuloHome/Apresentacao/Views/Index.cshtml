             class="card-img-top rounded-top-4 p-4 bg-white" alt="App Lista de Compras"
             style="object-fit: contain; max-height: 200px;"> *@

                <div class="card-body p-4">
                    <h5 class="card-title fw-bold text-dark mb-1">Lista de Compras</h5>

                    <div class="list-group mt-4">
                        <a class="btn btn-dark w-100 rounded-pill py-2 fw-medium shadow-sm" asp-controller=""
